# ToppersDeck — environment template.
# Copy this file to .env (same folder) and fill in the values.
# .env is ignored by git. Restart the API after you change it.

# ─────────────────────────────────────────────────────── DATABASE (required) ───
# Supabase dashboard → Connect → "Session pooler" → copy the URI.
# Replace [YOUR-PASSWORD] with the real database password.
# Use the pooler host (aws-0-<region>.pooler.supabase.com), not db.<ref>.supabase.co:
# the direct host is IPv6 only and does not work on Render/Railway.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# If the password contains @ / # or ?, leave DATABASE_URL empty and set these
# three instead. The app percent-encodes the password and builds the URL.
# SUPABASE_PROJECT_REF=
# SUPABASE_DB_PASSWORD=
# SUPABASE_DB_HOST=aws-0-YOUR_REGION.pooler.supabase.com

# ─────────────────────────────────────────────────────────────── SECURITY ───
# Required. At least 32 characters. Generate one with:  openssl rand -hex 32
# The app refuses to start without it. Use a different value per environment.
JWT_SECRET=

# ─────────────────────────────────────────────────────────────── PLATFORM ───
# The public address of the site. Used in email links.
PUBLIC_BASE_URL=http://localhost:5173
SUPPORT_EMAIL=hello@toppersdeck.com

# ────────────────────────────────────────────────────────────────── EMAIL ───
# MAIL_PROVIDER: console | smtp | resend
# console = no mail is sent; the OTP is returned in the API response (demo only).
MAIL_PROVIDER=console
MAIL_FROM_NAME=ToppersDeck
MAIL_FROM=
MAIL_REPLY_TO=

# Gmail with an App Password (see ENVIRONMENT.md → "Sending from Gmail")
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=

# Resend
RESEND_API_KEY=

# ──────────────────────────────────────────────────────────────────── SMS ───
# SMS_PROVIDER: console | msg91 | twilio | fast2sms
SMS_PROVIDER=console
SMS_DEFAULT_COUNTRY=91
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_OTP_TEMPLATE_ID=
MSG91_DLT_TE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
FAST2SMS_API_KEY=

# ─────────────────────────────────────────────────────── VIDEO / CALENDAR ───
# MEET_PROVIDER: jitsi | none
MEET_PROVIDER=jitsi
JITSI_BASE=https://meet.jit.si
REMINDER_MINUTES=60
NOTIFY_ENABLED=true
SEND_SESSION_INVITES=true
